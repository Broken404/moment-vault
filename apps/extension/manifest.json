{
  "manifest_version": 3,
  "name": "Moment Vault · 瞬间资产库",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "本地收集图片与视频，整理草稿并由你审核入库。",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Moment Vault · 显示桌宠" },
  "options_page": "manage.html#settings",
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-mode": { "description": "打开／关闭视频选段模式" },
    "record-selection": {
      "suggested_key": { "default": "Ctrl+Shift+9" },
      "description": "开始录制／提前结束"
    },
    "toggle-menu": { "description": "打开／关闭桌宠菜单" },
    "receive-images": { "description": "打开图片接收面板" }
  }
}
