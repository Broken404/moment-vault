{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "__MSG_actionTitle__" },
  "options_page": "manage.html#settings",
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-mode": { "description": "__MSG_toggleMode__" },
    "record-selection": {
      "suggested_key": { "default": "Ctrl+Shift+9" },
      "description": "__MSG_recordSelection__"
    },
    "toggle-menu": { "description": "__MSG_toggleMenu__" },
    "receive-images": { "description": "__MSG_receiveImages__" }
  }
}
