{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome", "vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["packages/shared/src/*"] }
  },
  "include": ["apps/extension/src", "packages/shared/src", "tests", "vite.config.ts"]
}
