{
  "manifest_version": 3,
  "name": "Moment Vault — technical spike",
  "version": "0.0.2",
  "key": "",
  "description": "Disposable local-file and selected-video capture experiment. Not a released product.",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage"],
  "host_permissions": ["https://*.bilibili.com/*", "https://*.youtube.com/*", "https://x.com/*", "https://twitter.com/*", "http://127.0.0.1:43817/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Open selected-video experiment"},
  "options_page": "probe.html",
  "externally_connectable": {"matches": ["http://127.0.0.1:43817/*"]},
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Show selection experiment"},
    "record-selection": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Record selected range / stop early"}
  },
  "content_scripts": [{"matches": ["https://*.bilibili.com/*", "https://*.youtube.com/*", "https://x.com/*", "https://twitter.com/*", "http://127.0.0.1:43817/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
